#!/usr/bin/env bash
# archfrican-bar-mode — the two things about waybar's layout you can switch at runtime.
#
#   archfrican-bar-mode status            # waybar JSON for the bar button (density)
#   archfrican-bar-mode toggle            # flip density: collapsed <-> expanded
#   archfrican-bar-mode collapsed         # groups hidden behind a hover (the default)
#   archfrican-bar-mode expanded          # every group's members on the bar at once
#   archfrican-bar-mode shape             # print the current shape
#   archfrican-bar-mode shape toggle      # flip shape: flat <-> islands
#   archfrican-bar-mode shape flat        # one continuous surface, edge to edge (the default)
#   archfrican-bar-mode shape islands     # three floating surfaces over the wallpaper
#
# Both settings are SYMLINKS into files that ship in the repo: ~/.config/waybar/mode.jsonc points at
# modes/{collapsed,expanded}.jsonc, and shape.css at shapes/{flat,islands}.css. Density is a config
# change and shape is a stylesheet change, but both take the same reload, so they share this script.
set -euo pipefail

CFG="${XDG_CONFIG_HOME:-$HOME/.config}/waybar"
MODE_LINK="$CFG/mode.jsonc"
SHAPE_LINK="$CFG/shape.css"

# Which target a link points at. A missing or dangling link reports the default rather than failing:
# both are healed below, and reporting the truth of what the bar is showing matters more than an error.
active() {   # $1=link  $2=non-default name  $3=default name
  case "$(readlink "$1" 2>/dev/null || true)" in
    *"$2".*) printf '%s\n' "$2" ;;
    *)       printf '%s\n' "$3" ;;
  esac
}

# SIGUSR2 makes waybar re-read config and stylesheet in place, which restarting the unit does not:
# a restart destroys the layer surface and builds a new one, and the bar is visibly GONE meanwhile.
# Measured by polling niri for the surface across a 3s window: absent in 2/360 samples after SIGUSR2
# (~17ms) against 35/362 after a unit restart (~290ms). The second reads as the whole bar blinking.
#
# SIGUSR2 is also the reload path carrying waybar's documented upstream segfault (issue list in
# modules/20-niri-desktop.sh). Taking it is a deliberate trade: theme-switch already sends it on every
# theme change, systemd's Restart=on-failure catches a crash, and the worst case therefore degrades to
# exactly the restart-shaped flash this avoids — never to a missing bar.
#
# The guard covers the one failure systemd will not repair by itself: enough crashes in a row to trip
# StartLimitBurst=5/10s, after which it stops trying and the bar stays gone until someone runs
# reset-failed by hand. For a switch reachable from a button ON the bar, that has to be impossible.
reload() {
  pkill -SIGUSR2 -x waybar 2>/dev/null || true
  systemctl --user cat waybar.service >/dev/null 2>&1 || return 0
  command -v systemd-run >/dev/null 2>&1 || return 0
  # Detached in its own transient unit, and that is not optional. This script normally runs as
  # waybar's on-click, so it is a child of waybar.service — if the reload does crash the bar, systemd
  # tears down the whole control group and would take this watchdog with it, exactly when it is
  # needed. --collect reaps the transient unit afterwards.
  systemd-run --user --collect --quiet -- sh -c '
    sleep 3
    systemctl --user is-active --quiet waybar.service && exit 0
    systemctl --user reset-failed waybar.service 2>/dev/null
    exec systemctl --user start waybar.service' 2>/dev/null || true
}

# ln -sfn is a rename(2): the link points at either the old target or the new one and never at
# anything in between. This script must NEVER write config or CSS itself — waybar treats a malformed
# include AND a malformed stylesheet as FATAL (exit 1, both verified), so with Restart=on-failure a
# half-written file leaves the bar dead until someone clears the failure counter by hand. Swapping a
# pointer cannot half-fail. Targets stay relative to the link's own directory, so $HOME can move.
set_link() {  # $1=link  $2=subdir  $3=name  $4=extension
  local rel="$2/$3.$4"
  [ -f "$CFG/$rel" ] || { printf 'archfrican-bar-mode: no such file: %s\n' "$CFG/$rel" >&2; exit 1; }
  ln -sfn "$rel" "$1"
  reload
}

# Repair a missing or dangling link. run_after_99-apply-theme.sh seeds both at install time; this is
# the backstop for whatever breaks one afterwards (a rename, a half-restored $HOME). It runs on the
# `status` path because waybar calls that at every start, so the bar heals itself by the next reload.
# Without it a broken mode link costs cpu, network and the tray, and a broken shape link costs the
# bar's entire background — in both cases quietly, because waybar only warns.
# -e follows symlinks, so a link pointing at a file that no longer exists counts as missing.
heal_link() {  # $1=link  $2=subdir  $3=default name  $4=extension
  [ -e "$1" ] && return 0
  [ -f "$CFG/$2/$3.$4" ] || return 0
  ln -sfn "$2/$3.$4" "$1" 2>/dev/null || true
}

case "${1:-status}" in
  status)
    heal_link "$MODE_LINK"  modes  collapsed jsonc
    heal_link "$SHAPE_LINK" shapes flat      css
    # U+F065 fa-expand / U+F066 fa-compress — the Font Awesome subset the rest of the bar uses. The
    # glyph shows the ACTION, not the state: an expand arrow means "click to expand".
    if [ "$(active "$MODE_LINK" expanded collapsed)" = expanded ]; then
      glyph="$(printf '\xef\x81\xa6')"; tip='Barra expandida — clic para colapsar'; cls=expanded
    else
      glyph="$(printf '\xef\x81\xa5')"; tip='Barra colapsada — clic para expandir'; cls=collapsed
    fi
    printf '{"text":"%s","class":"%s","tooltip":"%s"}\n' "$glyph" "$cls" "$tip"
    ;;
  toggle)
    if [ "$(active "$MODE_LINK" expanded collapsed)" = expanded ]
      then set_link "$MODE_LINK" modes collapsed jsonc
      else set_link "$MODE_LINK" modes expanded  jsonc
    fi
    ;;
  collapsed|expanded)
    set_link "$MODE_LINK" modes "$1" jsonc
    ;;
  shape)
    case "${2:-}" in
      '')       active "$SHAPE_LINK" islands flat ;;
      flat|islands) set_link "$SHAPE_LINK" shapes "$2" css ;;
      toggle)
        if [ "$(active "$SHAPE_LINK" islands flat)" = islands ]
          then set_link "$SHAPE_LINK" shapes flat    css
          else set_link "$SHAPE_LINK" shapes islands css
        fi ;;
      *) printf 'archfrican-bar-mode: unknown shape: %s (flat|islands|toggle)\n' "$2" >&2; exit 1 ;;
    esac
    ;;
  -h|--help)
    sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//'
    ;;
  *)
    printf 'archfrican-bar-mode: unknown command: %s (try --help)\n' "$1" >&2
    exit 1
    ;;
esac
