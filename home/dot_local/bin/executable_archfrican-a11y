#!/usr/bin/env bash
# Accessibility hub — screen reader, high contrast, larger cursor & text. Honest about niri's gaps
# (no mature Wayland-native magnifier or sticky/slow keys yet).
set -euo pipefail
B="$HOME/.local/bin"
gs() { timeout 5 gsettings "$@" 2>/dev/null || true; }   # timeout: gsettings can hang, not just fail, without a session bus
source "$(dirname "$0")/../lib/archfrican-common.sh"
prevfile="$HOME/.config/.archfrican-prev-theme"

# Accessibility token overrides. gsettings alone was NOT enough: theme-switch re-asserts the theme's
# own CURSOR_SIZE on every run, so a cursor set from this menu was reverted by the next theme change
# — including the one "Alto contraste: activar" below performs itself, plus darkman's twice-daily
# light/dark flip and every archfrican-update. Writing the override HERE makes it stick, because
# theme-switch sources this file LAST in its token cascade (after the theme's own tokens.sh).
# Must resolve to the SAME path theme-switch reads (bin/theme-switch, A11Y_TOKENS) — it honours
# XDG_CONFIG_HOME, so this has to as well. When the two disagreed, a session with XDG_CONFIG_HOME
# pointing outside ~/.config wrote the override here and read it from there: the accommodation was
# dropped in silence, which is the exact failure this whole layer exists to prevent.
a11ytokens="${XDG_CONFIG_HOME:-$HOME/.config}/archfrican/a11y-tokens.sh"
a11y_token() {                    # a11y_token <NAME> [value] ; no value = drop the override
  local name="$1" val="${2:-}" tmp
  mkdir -p "$(dirname "$a11ytokens")"
  if [ ! -f "$a11ytokens" ]; then
    printf '%s\n' \
      '# Accessibility overrides — written by archfrican-a11y, sourced LAST by theme-switch so they' \
      '# outrank every theme. An accommodation is a floor, not a suggestion. Safe to delete by hand.' \
      > "$a11ytokens"
  fi
  tmp="$(mktemp)"
  grep -v "^export $name=" "$a11ytokens" > "$tmp" || true
  if [ -n "$val" ]; then printf 'export %s="%s"\n' "$name" "$val" >> "$tmp"; fi
  mv "$tmp" "$a11ytokens"
}

sel="$(printf '%s\n' \
  "Lector de pantalla (Orca): alternar" \
  "Alto contraste: activar" \
  "Alto contraste: desactivar" \
  "Cursor grande" \
  "Cursor normal" \
  "Texto más grande" \
  "Texto normal" \
  "Magnificador / sticky keys (info)" \
  | fuzzel --dmenu --prompt '  accesibilidad  ')" || exit 0
case "$sel" in
  "Lector"*)
    "$B/archfrican-screenreader" ;;
  "Alto contraste: activar")
    cur="$(theme_now)"
    if [ "$cur" != high-contrast ]; then printf '%s\n' "$cur" > "$prevfile"; fi
    theme-switch high-contrast
    gs set org.gnome.desktop.a11y.interface high-contrast true ;;
  "Alto contraste: desactivar")
    theme-switch "$(cat "$prevfile" 2>/dev/null || echo "$ARCHFRICAN_DEFAULT_THEME")"
    gs set org.gnome.desktop.a11y.interface high-contrast false ;;
  # Both halves: gsettings for RIGHT NOW, the token override so it survives the next theme-switch.
  "Cursor grande")    a11y_token CURSOR_SIZE 48; gs set org.gnome.desktop.interface cursor-size 48; note "cursor grande" ;;
  "Cursor normal")    a11y_token CURSOR_SIZE;    gs set org.gnome.desktop.interface cursor-size 24; note "cursor normal" ;;
  "Texto más grande") gs set org.gnome.desktop.interface text-scaling-factor 1.25; note "texto más grande" ;;
  "Texto normal")     gs set org.gnome.desktop.interface text-scaling-factor 1.0; note "texto normal" ;;
  "Magnificador"*)    note "niri aún no tiene magnificador ni sticky-keys nativos en Wayland — en seguimiento upstream." ;;
esac
