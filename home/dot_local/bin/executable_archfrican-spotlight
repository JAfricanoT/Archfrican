#!/usr/bin/env bash
# Archfrican Spotlight — ⌘+Space. Primary surface: Walker (GTK4 — rich app grid, calc, files, web,
# clipboard, symbols, open windows) backed by the elephant daemon. Falls back to the pure-fuzzel launcher
# below if Walker/elephant aren't installed, so ⌘+Space never dies. Type to filter; prefixes jump modes.
set -euo pipefail
source "$(dirname "$0")/../lib/archfrican-common.sh"
B="$HOME/.local/bin"

# ── Walker path (preferred) ──────────────────────────────────────────────────────────────────────────
if have walker && have elephant; then
  # elephant is Walker's backend and must run in the session env; start it once if it isn't already up
  # (niri also spawns it at login — the guard keeps this from double-starting). Never fatal.
  pgrep -x elephant >/dev/null 2>&1 || setsid -f elephant >/dev/null 2>&1 || true
  exec walker
fi

# ── fuzzel fallback (self-contained; the original Spotlight) ─────────────────────────────────────────
have fuzzel || exit 1
TAB="$(printf '\t')"

# Mode shortcuts. Kept verbatim so the returned selection routes unambiguously; each gets a real
# freedesktop icon (below) so they sit alongside the apps as first-class Spotlight results.
M_CLIP="Portapapeles…"
M_ACT="Acciones y ajustes…"

# App index: "Name<TAB>desktop-id<TAB>icon" for every visible .desktop (the shared
# list_desktop_apps, with the .desktop suffix stripped for gtk-launch). Used to (a) render the
# list with icons and (b) map the chosen Name back to its launchable id. bash-3.2-safe: a temp
# file + awk, never an associative array.
idx="$(mktemp)"; trap 'rm -f "$idx"' EXIT
list_desktop_apps | awk -F'\t' -v OFS='\t' '{sub(/\.desktop$/, "", $2); print}' > "$idx"

# Feed fuzzel: the clipboard mode, then every app (alpha, de-duped by name) with its icon via the
# dmenu icon protocol (label \0 "icon" \x1f icon-name), and the settings hub LAST.
#
# fuzzel --dmenu has no ranking: this order is the order you see, whatever you typed. Pinning the
# settings hub to row 2 meant three letters aimed at an app were always read past an entry that
# launches nothing — the dilution the Walker path answers with the "," prefix. Last rather than gone:
# it is how someone who has not memorised a keybind still finds the way into the system, which is the
# job this file's own header claims ("discoverable instead of memorized").
build_list() {
  printf '%s\0icon\x1fedit-paste\n'                 "$M_CLIP"
  sort -t "$TAB" -k1,1 -u "$idx" | while IFS="$TAB" read -r name _id icon; do
    if [ -n "$icon" ]; then printf '%s\0icon\x1f%s\n' "$name" "$icon"; else printf '%s\n' "$name"; fi
  done
  printf '%s\0icon\x1fpreferences-system\n'         "$M_ACT"
}

sel="$(build_list | fuzzel --dmenu --prompt '   ')" || exit 0
[ -n "$sel" ] || exit 0

launch_app() {
  local name="$1" id
  id="$(awk -F"$TAB" -v n="$name" '$1==n {print $2; exit}' "$idx")"
  if [ -z "$id" ]; then
    if have notify-send; then notify-send "Archfrican" "no encuentro la app: $name"; fi
    return
  fi
  if have gtk-launch; then setsid -f gtk-launch "$id" >/dev/null 2>&1
  else setsid -f xdg-open "$id" >/dev/null 2>&1; fi
}

case "$sel" in
  "$M_CLIP") sh -c 'cliphist list | fuzzel --dmenu --prompt "   " | cliphist decode | wl-copy' ;;
  "$M_ACT")  "$B/archfrican-actions" ;;
  *)         launch_app "$sel" ;;
esac
