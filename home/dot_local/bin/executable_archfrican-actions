#!/usr/bin/env bash
# archfrican-actions — the command surface / "control center in the launcher".
# One fuzzel menu that reaches every Archfrican action and every launcher mode,
# the way Spotlight Actions / omarchy-menu / a KRunner do. Each item is a named
# verb (same spirit as the bin/ tools), so the keyboard-driven system stays
# discoverable instead of memorized.
#
# The fuzzel fallback reads menus/actions.toml directly (toml_menu_list/toml_menu_action,
# lib/archfrican-common.sh) instead of hand-duplicating its entries — one file is the source
# of truth for both the native Walker menu and this fallback, so they can't drift apart.
set -euo pipefail
source "$(dirname "$0")/../lib/archfrican-common.sh"
MENUS="${XDG_CONFIG_HOME:-$HOME/.config}/elephant/menus"

# Native menu (menus/actions.toml) when Walker/elephant are up; fuzzel fallback below otherwise.
walker_menu actions

have fuzzel  || { note "fuzzel no está instalado"; exit 1; }
have python3 || { note "falta python3"; exit 1; }

# "Cambiar tema…" is backed by a Lua provider (menus/themes.lua), not a static .toml — the
# fallback uses the shared pick_theme (archfrican-common.sh), which replicates that live
# discovery instead of trying to read a themes.toml that doesn't exist.

# Entering a submenu used to be a one-way trip: pick "Pantallas / monitores", change your mind, and
# the whole menu was gone. BACK gives the fallback the same "go up one level" the native Walker menu
# gets from `menus:parent` (Escape / Alt+Left — see walker/config.toml). It's plain text, so
# toml_menu_action simply doesn't match it and the caller handles it before ever looking it up.
BACK="←  Volver"

# run_toml_menu <file.toml> <prompt> [is-submenu] — list its entries in fuzzel; run (or open in a
# terminal) the chosen one, or recurse into its submenu (another sibling .toml, or the one
# special-cased Lua menu).
#
# Exit status is the navigation verdict, because "the submenu closed" and "the submenu ran something"
# must not look alike to the parent:
#   0 -> went back / cancelled  ->  the caller re-shows its own list (you land where you were)
#   2 -> an entry ran           ->  every level returns, the menu is done
# `|| rc=$?` around the recursion keeps `set -e` out of it, since 2 is a deliberate status.
run_toml_menu() {
  local file="$1" prompt="$2" sub="${3:-}" sel line kind value rc
  [ -r "$file" ] || { note "no encuentro $(basename "$file")"; return 1; }
  while :; do
    sel="$( { [ -n "$sub" ] && printf '%s\n' "$BACK"; toml_menu_list "$file"; } \
            | fuzzel --dmenu --prompt "$prompt")" || return 0
    [ -n "$sel" ] || return 0
    if [ "$sel" = "$BACK" ]; then return 0; fi
    line="$(toml_menu_action "$file" "$sel")"
    [ -n "$line" ] || return 0
    kind="${line%%$'\t'*}"; value="${line#*$'\t'}"
    case "$kind" in
      run)      sh -c "$value"; return 2 ;;
      terminal) ghostty -e sh -c "$value"; return 2 ;;
      submenu)
        rc=0
        case "$value" in
          themes) pick_theme ;;
          *)      run_toml_menu "$MENUS/$value.toml" "  $value  " sub || rc=$? ;;
        esac
        if [ "$rc" -eq 2 ]; then return 2; fi
        ;;
    esac
  done
}

run_toml_menu "$MENUS/actions.toml" "  acciones  " || true
