#!/usr/bin/env bash
# archfrican-defaults — set default apps the macOS way, but USEFUL: per category it shows only the
# RELEVANT apps — the ones you have installed, PLUS "⤓ Instalar X…" for the common ones you don't —
# and reassigns all of that category's url/mime handlers at once. "Otra app instalada…" is the escape
# hatch to the full list. xdg-utils + pacman/paru/flatpak; installs run in a ghostty terminal.
set -euo pipefail
source "$(dirname "$0")/../lib/archfrican-common.sh"
have fuzzel || { echo "fuzzel required" >&2; exit 1; }
have_desktop() { local id="$1" d; for d in "${ARCHFRICAN_APPDIRS[@]}"; do [ -e "$d/$id" ] && return 0; done; return 1; }
is_installed() { case "$1" in cli) have "$2" ;; action) return 0 ;; *) have_desktop "$2" ;; esac; }   # CLI tool (cmd) vs GUI app (.desktop) vs always-available action

list_apps() {   # "Name<TAB>id.desktop" for every visible app — the fallback ("Otra app instalada…")
  list_desktop_apps | cut -f1,2 | sort -u
}

do_install() {  # do_install <spec> ; spec = repo:pkgs | aur:pkgs | flatpak:appid | script:url | module:name (in a terminal)
  local kind="${1%%:*}" pkg="${1#*:}"
  case "$kind" in
    repo)    ghostty -e sh -c "sudo pacman -S --needed -- $pkg; printf '\n(enter para cerrar) '; read -r _" ;;
    aur)     if have paru; then ghostty -e sh -c "paru -S --needed -- $pkg; printf '\n(enter para cerrar) '; read -r _"
             else note "paru (AUR) no disponible"; return 1; fi ;;
    # Same as `aur:`, but for AUR picks with a hard package conflict or a system-wide install
    # script (modifying /etc/hosts, auto-enabling a systemd unit for every user, etc.) — shows
    # what's about to happen and waits for y/N before running paru. Points at the AUR page
    # itself rather than hardcoding today's specifics, since a PKGBUILD can change them later.
    aur-warn) if have paru; then
                # shellcheck disable=SC2016  # $AF_PKG is expanded by the INNER sh -c, single quotes are intentional
                ghostty -e env AF_PKG="$pkg" sh -c '
                  echo "This AUR package makes broader-than-usual changes to your system — check"
                  echo "its AUR page (conflicts, install script) before continuing:"
                  echo "  https://aur.archlinux.org/packages/$AF_PKG"
                  printf "Install %s anyway? [y/N] " "$AF_PKG"
                  read -r ans
                  case "$ans" in
                    y|Y) paru -S --needed -- "$AF_PKG" ;;
                    *) echo "cancelled" ;;
                  esac
                  printf "\n(enter para cerrar) "; read -r _
                '
              else note "paru (AUR) no disponible"; return 1; fi ;;
    flatpak) if have flatpak; then ghostty -e sh -c "flatpak install -y flathub $pkg; printf '\n(enter para cerrar) '; read -r _"
             else note "flatpak no disponible"; return 1; fi ;;
    # A whole phase-2 module (e.g. 67-virtualization) instead of a bare package — for features
    # that need more than `pacman -S` (services enabled, groups added, config written). Same
    # terminal + "yes" argument gaming/Plasma's own actions-menu install entries already use;
    # content-addressed, so re-picking an already-installed one is a fast idempotent no-op.
    # `;`-joined commands mean the terminal's own exit status is just `read`'s (always ~0), never
    # install.sh's real result — so instead of trusting that, compare the module's own .done stamp
    # (lib/converge.sh/lib/phase2.sh: only (re)written by run_module on a REAL success, and the
    # single-module `install.sh <mod> yes` path always forces a re-run+rewrite via FORCE=1, even
    # when nothing changed) before vs after. A stale/missing stamp after running -> real failure,
    # caught here instead of apply_category() reporting "listo" off a stale desktop-file check.
    module)  local mstamp="${XDG_STATE_HOME:-$HOME/.local/state}/archfrican/$pkg.done" mbefore=""
             [ -f "$mstamp" ] && mbefore="$(stat -c %Y "$mstamp" 2>/dev/null)"
             ghostty -e sh -c "'$HOME/.archfrican/install.sh' '$pkg' yes; printf '\n(enter para cerrar) '; read -r _"
             if [ -f "$mstamp" ] && [ "$(stat -c %Y "$mstamp" 2>/dev/null)" != "$mbefore" ]; then :
             else note "el módulo $pkg no terminó bien — revisá la terminal"; return 1; fi ;;
    # Vendors' official one-line installer (e.g. Claude Code) — more reliable than the flaky AUR
    # wrappers for fast-moving AI CLIs. URL is hardcoded in the table, never user input.
    script)  if have curl; then ghostty -e sh -c "curl -fsSL '$pkg' | bash; printf '\n(enter para cerrar) '; read -r _"
             else note "curl no disponible"; return 1; fi ;;
    # For services with no native Linux client (e.g. WhatsApp) — wraps archfrican-webapp, the
    # project's existing answer for this. spec = webapp:Name,https://url (name/url hardcoded in the table).
    # Absolute path, NOT a PATH lookup: niri-spawned processes (this script included) inherit the
    # systemd --user session PATH, which has no ~/.local/bin (only the interactive zsh PATH does) —
    # same reason the "Control de versiones" case below uses $HOME/.local/bin/archfrican-git.
    webapp)  if [ -x "$HOME/.local/bin/archfrican-webapp" ]; then local wname="${pkg%%,*}" wurl="${pkg#*,}"
               ghostty -e sh -c "'$HOME/.local/bin/archfrican-webapp' '$wname' '$wurl'; printf '\n(enter para cerrar) '; read -r _"
             else note "archfrican-webapp no disponible"; return 1; fi ;;
    *) return 1 ;;
  esac
}

pkg_installed() {  # did the package from this <spec> install? (repo/aur via pacman) — a robust fallback
  local kind="${1%%:*}" pkg="${1#*:}"                                 # when a guessed .desktop id is wrong
  case "$kind" in
    repo|aur|aur-warn) have pacman && pacman -Qq "${pkg%% *}" >/dev/null 2>&1 ;;
    *) return 1 ;;
  esac
}

# A few apps are only HALF installed by their package: the daemon that does the actual work ships
# disabled, and upstream settles for a post-install note nobody ever sees. Both remote-desktop picks
# are like this — rustdesk-bin prints "The RustDesk daemon must be started for RustDesk to work […]
# systemctl enable --now rustdesk", anydesk-bin the same for unattended access. Without it the box
# never registers with the ID server, so every INBOUND connection fails (the app itself launches and
# looks perfectly installed, which is what makes this so confusing to diagnose from the other end).
# Runs on EVERY pick, not just after a fresh install: a machine where the app was already installed
# with its service off is exactly the case this repairs — re-picking it in this menu is the fix.
ensure_service() {   # ensure_service <unit> <display>
  local unit="$1" disp="$2"
  have systemctl || return 0
  # No such unit (package dropped it, or a flatpak/other build) — nothing to enable, stay quiet.
  systemctl list-unit-files --no-legend -- "$unit" 2>/dev/null | grep -q . || return 0
  if systemctl is-enabled --quiet "$unit" 2>/dev/null && systemctl is-active --quiet "$unit" 2>/dev/null; then
    return 0
  fi
  have ghostty || { note "$disp: activá su servicio con  sudo systemctl enable --now $unit"; return 0; }
  # Positional args into the inner sh, never string-interpolated into its script text (the same
  # pattern archfrican-vm-windows uses) — these values are hardcoded in the table above, but the
  # quoting stays safe by construction rather than by trusting the caller.
  # shellcheck disable=SC2016  # $1/$2 are expanded by the INNER sh, single quotes are intentional
  ghostty -e sh -c '
    echo "$2 necesita su servicio de sistema activo para aceptar conexiones entrantes."
    echo "Sin él la app abre igual, pero nadie puede conectarse a esta máquina."
    echo
    sudo systemctl enable --now "$1" || echo "no se pudo activar $1"
    printf "\n(enter para cerrar) "; read -r _
  ' _ "$unit" "$disp"
}

apply_default() {  # apply_default <desktop-id> <how> [mime...] ; how = browser | mime | terminal
  local id="$1" how="$2"; shift 2
  case "$how" in
    terminal) mkdir -p "$HOME/.config"; printf '%s\n' "$id" > "$HOME/.config/xdg-terminals.list" ;;
    browser)  if have xdg-settings; then xdg-settings set default-web-browser "$id" 2>/dev/null || true; fi
              for m in "$@"; do xdg-mime default "$id" "$m"; done ;;
    mime)     for m in "$@"; do xdg-mime default "$id" "$m"; done ;;
  esac
}

category_data() {   # category_data <slug> ; sets HOW, TARGETS, ROWS (global, for this call only)
  case "$1" in
    browser)
      HOW=browser; TARGETS='x-scheme-handler/http x-scheme-handler/https text/html'
      ROWS=(
        "Firefox|firefox.desktop|repo:firefox"
        "Brave|brave-browser.desktop|aur:brave-bin"
        "Chromium|chromium.desktop|repo:chromium"
        "Vivaldi|vivaldi-stable.desktop|aur:vivaldi"
        "Mullvad Browser|mullvad-browser.desktop|aur:mullvad-browser-bin"
      ) ;;
    editor)
      HOW=mime; TARGETS='text/plain text/markdown application/json text/x-csrc text/x-c++src text/x-python application/x-shellscript text/x-java'
      ROWS=(
        "VS Code (OSS)|code-oss.desktop|repo:code"
        "Zed|dev.zed.Zed.desktop|repo:zed"
        "Neovim (terminal)|nvim.desktop|repo:neovim"
        "Gnome Text Editor|org.gnome.TextEditor.desktop|repo:gnome-text-editor"
        "Kate|org.kde.kate.desktop|repo:kate"
        "Cursor|cursor.desktop|aur:cursor-bin"
        "Antigravity|antigravity-ide.desktop|aur:antigravity-ide"
        # Orca the ADE (onorca.dev — a fleet of parallel coding agents), NOT `orca` the GNOME screen
        # reader this repo installs on every desktop (⌘+Alt+S). Two unrelated programs, one name:
        # keying this row on a bare `orca` would report the ADE installed on every Archfrican box.
        # orca-ide-bin ships /usr/bin/orca-ide + orca-ide.desktop, so neither the row below nor
        # archfrican-screenreader's `pgrep -x orca` can be fooled by the other program.
        "Orca (ADE)|orca-ide.desktop|aur:orca-ide-bin"
      ) ;;
    ia-cli)
      HOW=cli; TARGETS=''
      ROWS=(
        "Claude Code|claude|script:https://claude.ai/install.sh"
        # Upstream's CLI is `od`, which coreutils already owns (octal dump) — the AUR package ships it
        # as `open-design`. It drives whichever agent CLI above is installed; it has none of its own.
        "Open Design|open-design|aur:open-design"
        "OpenCode|opencode|aur:opencode-bin"
        "Gemini CLI|gemini|aur:gemini-cli-git"
        "Aider|aider|aur:aider-chat"
        "Codex CLI|codex|aur:openai-codex-bin"
      ) ;;
    terminal)
      HOW=terminal; TARGETS=''
      ROWS=(
        "Ghostty|com.mitchellh.ghostty.desktop|repo:ghostty"
        "Kitty|kitty.desktop|repo:kitty"
        "Alacritty|Alacritty.desktop|repo:alacritty"
        "foot|foot.desktop|repo:foot"
      ) ;;
    archivos)
      HOW=mime; TARGETS='inode/directory'
      ROWS=(
        "Nautilus (Files)|org.gnome.Nautilus.desktop|repo:nautilus"
        "Dolphin|org.kde.dolphin.desktop|repo:dolphin"
        "Thunar|thunar.desktop|repo:thunar"
        "Nemo|nemo.desktop|repo:nemo"
      ) ;;
    pdf)
      HOW=mime; TARGETS='application/pdf'
      ROWS=(
        "Papers / Evince|org.gnome.Evince.desktop|repo:evince"
        "Okular|org.kde.okular.desktop|repo:okular"
        "Zathura|org.pwmt.zathura.desktop|repo:zathura zathura-pdf-mupdf"
      ) ;;
    imagenes)
      HOW=mime; TARGETS='image/png image/jpeg image/gif image/webp image/svg+xml image/tiff image/bmp'
      ROWS=(
        "Loupe|org.gnome.Loupe.desktop|repo:loupe"
        "Image Viewer (eog)|org.gnome.eog.desktop|repo:eog"
        "gThumb|org.gnome.gThumb.desktop|repo:gthumb"
        "imv|imv.desktop|repo:imv"
      ) ;;
    ofimatica)
      # One id -> every target (doc/xls/ppt legacy + OOXML + ODF) works because OnlyOffice
      # DesktopEditors is a single unified app/window for all three, unlike LibreOffice (separate
      # Writer/Calc/Impress .desktop files per format — doesn't fit this category's one-id model).
      HOW=mime
      TARGETS='application/msword application/vnd.openxmlformats-officedocument.wordprocessingml.document application/vnd.ms-excel application/vnd.openxmlformats-officedocument.spreadsheetml.sheet application/vnd.ms-powerpoint application/vnd.openxmlformats-officedocument.presentationml.presentation application/vnd.oasis.opendocument.text application/vnd.oasis.opendocument.spreadsheet application/vnd.oasis.opendocument.presentation'
      ROWS=(
        "OnlyOffice|onlyoffice-desktopeditors.desktop|aur:onlyoffice-bin"
      ) ;;
    correo)
      HOW=mime; TARGETS='x-scheme-handler/mailto'
      ROWS=(
        "Thunderbird|thunderbird.desktop|repo:thunderbird"
        "Geary|org.gnome.Geary.desktop|repo:geary"
        "Evolution|org.gnome.Evolution.desktop|repo:evolution"
      ) ;;
    contenedores)
      HOW=cli; TARGETS=''
      ROWS=(
        "LazyDocker|lazydocker|repo:lazydocker"
        "Docker Desktop|docker-desktop.desktop|aur-warn:docker-desktop|none"
      ) ;;
    mensajeria)
      HOW=none; TARGETS=''
      ROWS=(
        "Telegram|org.telegram.desktop.desktop|flatpak:org.telegram.desktop"
        "Signal|org.signal.Signal.desktop|flatpak:org.signal.Signal"
        "Discord|com.discordapp.Discord.desktop|flatpak:com.discordapp.Discord"
        "WhatsApp (web app)|archfrican-webapp-whatsapp.desktop|webapp:WhatsApp,https://web.whatsapp.com"
      ) ;;
    remoto)
      # 5th field = the systemd unit that must be RUNNING for the app to be reachable at all; see
      # ensure_service(). Unique to this category so far — every other row leaves it empty.
      HOW=none; TARGETS=''
      ROWS=(
        "RustDesk|rustdesk.desktop|aur:rustdesk-bin|none|rustdesk.service"
        "AnyDesk|anydesk.desktop|aur:anydesk-bin|none|anydesk.service"
      ) ;;
    vpn)
      # Every row here is cli-kind, unlike the other "just install it" categories: none of these
      # ship a .desktop file, so a desktop-kind check would report "not installed" on a fully
      # provisioned box. The NetworkManager plugins have no binary of their own either — they pull
      # openvpn/openconnect, which do, and that's what each row is keyed on.
      # WireGuard leads: it is the predefined VPN. NetworkManager speaks WireGuard natively (no
      # plugin, no wg-quick unit), so wireguard-tools plus nm-connection-editor's own WireGuard page
      # is the whole stack — archfrican-vpn is where you actually raise a tunnel.
      # The first four are already in packages/niri-desktop.txt, so on a real desktop they read as
      # installed from day one; this category declares them as the set and repairs a box missing any.
      HOW=none; TARGETS=''
      ROWS=(
        "WireGuard (NetworkManager)|wg|repo:wireguard-tools|cli"
        "Tailscale (malla)|tailscale|repo:tailscale|cli"
        "OpenVPN (NetworkManager)|openvpn|repo:networkmanager-openvpn|cli"
        "OpenConnect / AnyConnect|openconnect|repo:networkmanager-openconnect|cli"
        # Mullvad has its own guided installer here (VPN + Mullvad Browser, AUR, opt-in) — an action
        # row reusing it, rather than a second copy of that script's package logic in this table.
        "Mullvad VPN (guiado)…|archfrican-mullvad|$HOME/.local/bin/archfrican-mullvad|action"
      ) ;;
    virtualizacion)
      HOW=none; TARGETS=''
      ROWS=(
        "Máquinas virtuales (virt-manager)|virt-manager.desktop|module:67-virtualization"
        "Crear VM de Windows (guiado)…|archfrican-vm-windows|$HOME/.local/bin/archfrican-vm-windows|action"
      ) ;;
    *) return 1 ;;
  esac
}

list_category() {   # list_category <slug> ; TSV: display<TAB>installed(0|1)
  category_data "$1" || return 1
  # svc is read even though this function ignores it: `read` stuffs everything after the 4th
  # delimiter into the LAST variable, so parsing one field short would leave row_how holding
  # "none|rustdesk.service" and break the cli/none/desktop dispatch in is_installed().
  local row disp id spec row_how svc
  for row in "${ROWS[@]}"; do
    IFS='|' read -r disp id spec row_how svc <<<"$row"; row_how="${row_how:-$HOW}"
    if is_installed "$row_how" "$id"; then printf '%s\t1\n' "$disp"; else printf '%s\t0\n' "$disp"; fi
  done
}

apply_category() {   # apply_category <slug> <display> ; same dispatch category()'s second half already did
  category_data "$1" || return 1
  local want="$2" row disp id spec row_how svc
  local tgt=(); [ -n "$TARGETS" ] && read -r -a tgt <<<"$TARGETS"
  for row in "${ROWS[@]}"; do
    IFS='|' read -r disp id spec row_how svc <<<"$row"; row_how="${row_how:-$HOW}"
    [ "$disp" = "$want" ] || continue
    # action: always "installed" (never "⤓ Instalar…") — picking it just runs $spec directly,
    # no install-check/default-assignment semantics apply (e.g. a guided helper, not an app).
    # Guarded like the webapp case above: exec-ing a missing/non-executable $spec under
    # set -euo pipefail would otherwise kill the whole archfrican-defaults process with a raw
    # "exec: ...: No such file or directory" instead of this file's own friendly note().
    if [ "$row_how" = action ]; then
      [ -x "$spec" ] || { note "$disp no disponible"; return 0; }
      exec "$spec"
    fi
    if ! is_installed "$row_how" "$id"; then
      do_install "$spec" || return 0
      if ! is_installed "$row_how" "$id" && ! pkg_installed "$spec"; then note "$disp no quedó instalado"; return 0; fi
    fi
    # AFTER the install check and OUTSIDE it: an app that was already installed with its daemon
    # off is the case that needs this most (see ensure_service).
    if [ -n "$svc" ]; then ensure_service "$svc" "$disp"; fi
    if [ "$row_how" = cli ] || [ "$row_how" = none ]; then note "$disp listo ✓"
    else apply_default "$id" "$row_how" ${tgt[@]+"${tgt[@]}"}; note "Por defecto: $disp"; fi
    return 0
  done
}

CATEGORY_LABELS=(
  "browser|Navegador web" "editor|Editor / IDE" "ia-cli|IA / agentes (CLI)" "terminal|Terminal"
  "archivos|Gestor de archivos" "pdf|Visor de PDF" "imagenes|Visor de imágenes"
  "ofimatica|Ofimática (Word/Excel/PowerPoint)" "correo|Correo"
  "contenedores|Gestor de contenedores" "mensajeria|Mensajería" "remoto|Acceso remoto"
  "vpn|VPN" "virtualizacion|Máquinas virtuales"
)

case "${1:-}" in
  __list)  list_category "$2" ;;
  __apply) apply_category "$2" "$3" ;;
  *)
    walker_menu defaults
    cat="$(printf '%s\n' \
      "Navegador web" "Editor / IDE" "IA / agentes (CLI)" "Terminal" "Gestor de archivos" \
      "Visor de PDF" "Visor de imágenes" "Ofimática (Word/Excel/PowerPoint)" "Correo" \
      "Gestor de contenedores" "Mensajería" \
      "Acceso remoto" "VPN" "Máquinas virtuales" "Control de versiones · Git…" \
      | fuzzel --dmenu --prompt '  app por defecto  ')" || exit 0
    slug=""
    case "$cat" in
      "Control de versiones"*) exec "$HOME/.local/bin/archfrican-git" ;;
      "Navegador web") slug=browser ;;
      "Editor / IDE") slug=editor ;;
      "IA / agentes (CLI)") slug=ia-cli ;;
      "Terminal") slug=terminal ;;
      "Gestor de archivos") slug=archivos ;;
      "Visor de PDF") slug=pdf ;;
      "Visor de imágenes") slug=imagenes ;;
      "Ofimática (Word/Excel/PowerPoint)") slug=ofimatica ;;
      "Correo") slug=correo ;;
      "Gestor de contenedores") slug=contenedores ;;
      "Mensajería") slug=mensajeria ;;
      "Acceso remoto") slug=remoto ;;
      "VPN") slug=vpn ;;
      "Máquinas virtuales") slug=virtualizacion ;;
    esac
    [ -n "$slug" ] || exit 0
    category_data "$slug"
    local_prompt="$(printf '%s\n' "${CATEGORY_LABELS[@]}" | awk -F'|' -v s="$slug" '$1==s{print $2}')"
    entries=(); for row in "${ROWS[@]}"; do
      IFS='|' read -r disp id spec row_how svc <<<"$row"; row_how="${row_how:-$HOW}"   # svc: see list_category
      if is_installed "$row_how" "$id"; then entries+=("$disp"); else entries+=("⤓ Instalar $disp…"); fi
    done
    [ "$HOW" = cli ] || entries+=("Otra app instalada…")
    sel="$(printf '%s\n' "${entries[@]}" | fuzzel --dmenu --prompt "  $local_prompt  ")" || exit 0
    [ -n "$sel" ] || exit 0
    if [ "$sel" = "Otra app instalada…" ]; then
      id="$(list_apps | fuzzel --dmenu --prompt "  $local_prompt  " | cut -f2)"; [ -n "$id" ] || exit 0
      tgt=(); [ -n "$TARGETS" ] && read -r -a tgt <<<"$TARGETS"
      apply_default "$id" "$HOW" ${tgt[@]+"${tgt[@]}"}; note "Por defecto: $id"; exit 0
    fi
    want="${sel#⤓ Instalar }"; want="${want%…}"
    apply_category "$slug" "$want" ;;
esac
