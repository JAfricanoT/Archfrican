{
  "layer": "top",
  "position": "top",
  // 30px + spacing 2: the bar is meant to read dense. Vertical air is trimmed to what the 14px clock
  // actually needs (~25px of content), and inter-module spacing is halved — with ~20 modules on the
  // right, every px of "spacing" is spent twenty times over.
  "height": 30,
  "spacing": 2,
  // No margins: the bar is one flat plane docked to the top edge. Dropping them also shrinks the
  // layer-shell exclusive zone from 40 to 34, so windows tile 6px higher. Inner breathing room is
  // style.css's job (.modules-left/right padding), not a gap around the surface.
  "modules-left": ["niri/workspaces", "niri/window"],
  // center island: weather pill (left) + clock anchor (right)
  "modules-center": ["custom/weather", "clock"],
  // Only what a developer acts on stays permanently visible; everything else is one click away inside
  // a drawer group.
  //
  // battery and custom/connectivity are NOT in the drawers, and that is the whole point of where they
  // sit. Both carry alarm states — #battery.warning/.critical and #custom-connectivity.offline — and
  // a collapsed drawer makes those CSS rules dead code: a laptop at 4% would show nothing at all.
  // A module that can raise an alarm cannot live behind a gesture. Only what you go LOOKING for can.
  "modules-right": [
    "pulseaudio",
    "group/system",
    "battery",
    "group/net",
    "custom/connectivity",
    "custom/health", "custom/github", "custom/notification", "custom/caffeine", "custom/privacy",
    "group/systray",
    "custom/power"
  ],

  // A `drawer` group hides all but its FIRST module, revealing the rest. children-class gives the
  // hidden modules a styling hook.
  //
  // click-to-reveal, not hover: expanding a group reallocates ~200px, which slides the leader itself
  // out from under the pointer — so you cannot reliably click a handle, because opening it moves it.
  // A click also makes the reflow intentional rather than something a stray crossing triggers, gives
  // touch and pointer-emulation a route in, and lets the tooltips finally do their job (on hover the
  // very gesture that raises the tooltip has already opened the drawer, so it explained nothing).
  //
  // transition-left-to-right only sets the ANIMATION direction. An earlier comment here claimed it
  // made the group "grow into the empty centre instead of shoving its neighbours" — it does not; the
  // final size allocation is identical either way. It is kept because sliding away from the screen
  // edge reads better, not because it protects the layout.
  "group/system": {
    "orientation": "horizontal",
    "drawer": { "transition-duration": 150, "children-class": "drawer-child", "transition-left-to-right": false, "click-to-reveal": true },
    "modules": ["cpu", "memory", "disk", "power-profiles-daemon"]
  },
  "group/net": {
    "orientation": "horizontal",
    "drawer": { "transition-duration": 150, "children-class": "drawer-child", "transition-left-to-right": false, "click-to-reveal": true },
    "modules": ["network", "bluetooth"]
  },
  // Named "systray", NOT "tray": a group takes the CSS id of its name, and #tray is already owned by
  // the tray module nested inside this very group. The collision would style both at once.
  "group/systray": {
    "orientation": "horizontal",
    "drawer": { "transition-duration": 150, "children-class": "drawer-child", "transition-left-to-right": false, "click-to-reveal": true },
    "modules": ["custom/systray-toggle", "tray"]
  },

  // The tray drawer's handle. U+F141 (fa-ellipsis-h), from the same Font Awesome subset as the rest
  // of this config. The glyph is echoed by a real `exec` rather than written as a static `format`:
  // a custom module with no exec never runs an update cycle, so it renders at zero width — a handle
  // with nothing to click, which makes the drawer silently unopenable.
  "custom/systray-toggle": {
    "format": "{}",
    "exec": "echo ''",
    "interval": "once",
    "tooltip-format": "Bandeja del sistema"
  },

  "niri/workspaces": { "format": "{icon}" },

  // center clock — full day name for a richer feel; hover shows inline calendar; click opens gsimplecal
  "clock": {
    "format": "{:%A, %d %b   %H:%M}",
    "tooltip-format": "<big>{:%B %Y}</big>\n<tt><small>{calendar}</small></tt>",
    "on-click": "sh -c 'command -v gsimplecal && exec gsimplecal || command -v gnome-calendar && exec gnome-calendar || true'"
  },

  // system stats — click memory to jump to btop (cpu cannot carry it; see below)
  // cpu leads the system drawer and does double duty: a mute icon while the machine is calm, and its
  // own alarm past 80% — both the handle you click and an alert you cannot miss.
  //
  // It carries NO on-click. waybar warns that "grouped modules may still process their own on-click
  // events", so a click on a drawer leader would open the group AND fire the action. btop stays one
  // click away on `memory`, inside the drawer. Rule for this bar: a drawer leader never has on-click.
  //
  // An earlier comment here justified hiding memory and disk by claiming archfrican-doctor "is
  // permanently visible now and already reports a filling disk". Both halves were false: the badge
  // prints an empty string when healthy, so it hides itself precisely when nothing is wrong, and
  // lib/health.sh has no battery check at all. Memory and disk are hidden because they are consulted,
  // not watched — btop answers them better than three figures at 12px.
  "cpu": {
    "format": "",
    "format-critical": "  {usage}%",
    "states": { "critical": 80 },
    "tooltip-format": "CPU {usage}%"
  },
  "memory": { "format": "  {}%",      "on-click": "ghostty -e btop", "tooltip": false },
  "disk":   { "format": "  {free}",   "tooltip-format": "{used} / {total} ({percentage_used}%)\n{path}" },

  "battery": {
    "format": "{icon}  {capacity}%",
    "format-icons": ["", "", "", "", ""]
  },
  // power-profiles icons: nf-fa-rocket (performance) · nf-fa-bolt (balanced) · nf-fa-leaf (power-saver)
  // U+F135 / U+F0E7 / U+F06C — all Font Awesome subset, stable across NF v2→v3
  "power-profiles-daemon": {
    "format": "{icon}",
    "tooltip-format": "Perfil de energía: {profile}",
    "format-icons": {
      "performance": "",
      "balanced":    "",
      "power-saver": ""
    }
  },

  "network": {
    "format-wifi":        "",
    "format-ethernet":    "",
    "format-disconnected": "",
    "tooltip-format-ethernet":   "{ifname} · IP {ipaddr}/{cidr}\nGateway {gwaddr}",
    "tooltip-format-wifi":       "{essid} ({signalStrength}%) · IP {ipaddr}/{cidr}\nGateway {gwaddr}",
    "tooltip-format-disconnected": "Sin red"
  },
  // 60s, not 10s: up to 3 ICMP round-trips + up to 3s blocked per tick — at 10s that's ~8640
  // pings/day forever, enough to keep a laptop's WiFi radio from power-saving. Still catches a
  // real outage within a minute.
  "custom/connectivity": {
    "format": "{}",
    "return-type": "json",
    "interval": 60,
    "exec": "$HOME/.local/bin/archfrican-net-status",
    "tooltip": true
  },
  "bluetooth": {
    "format":           "",
    "format-disabled":  "",
    "format-connected": "  {num_connections}",
    "tooltip-format": "{controller_alias}\t{status}",
    "on-click": "blueman-manager"
  },

  // --- right-side status modules ---
  "custom/health": {
    "format": "{}",
    "return-type": "json",
    "interval": 1800,
    "exec": "archfrican-doctor --json",
    "on-click": "ghostty -e sh -c 'archfrican-doctor; echo; echo \"(enter para cerrar)\"; read -r _'",
    "tooltip": true
  },
  // 300s: gh's authenticated API allows 5000 req/h, so this is far under budget; empty text +
  // "hidden" tooltip when gh isn't installed/authenticated — the module just visually disappears.
  "custom/github": {
    "format": "{}",
    "return-type": "json",
    "interval": 300,
    "exec": "$HOME/.local/bin/archfrican-gh-status",
    "on-click": "xdg-open 'https://github.com/notifications?query=is%3Aunread'",
    "tooltip": true
  },
  "custom/privacy": {
    "format": "{}",
    "return-type": "json",
    "interval": 3,
    "exec": "$HOME/.local/bin/archfrican-privacy-indicator",
    "tooltip": true
  },
  "custom/notification": {
    "tooltip": false,
    "format": "{icon}",
    "format-icons": {
      "notification": "", "none": "",
      "dnd-notification": "", "dnd-none": "",
      "inhibited-notification": "", "inhibited-none": "",
      "dnd-inhibited-notification": "", "dnd-inhibited-none": ""
    },
    "return-type": "json",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true
  },

  // caffeine: click to inhibit idle (stop screen-lock / auto-suspend); SIGRTMIN+8 for instant refresh
  "custom/caffeine": {
    "format": "{}",
    "return-type": "json",
    "interval": "once",
    "exec": "$HOME/.local/bin/archfrican-caffeine",
    "on-click": "$HOME/.local/bin/archfrican-caffeine toggle",
    "signal": 8,
    "tooltip": true
  },

  // weather: auto-derived from system timezone; echo "off" > ~/.config/archfrican/weather to disable
  "custom/weather": {
    "format": "{}",
    "return-type": "json",
    "interval": 1800,
    "exec": "$HOME/.local/bin/archfrican-weather",
    "tooltip": true
  },

  "pulseaudio": {
    "format": "{icon}",
    "format-muted": "",
    "format-icons": { "default": ["", "", ""] },
    "tooltip-format": "{volume}% — {desc}",
    "on-click": "pavucontrol"
  },
  "tray": { "spacing": 4 },
  // power/system menu — nf-fa-power-off, U+F011 (see docs/superpowers/specs/2026-07-06-waybar-power-menu-design.md)
  "custom/power": {
    "format": "",
    "tooltip-format": "Energía / sistema",
    "on-click": "$HOME/.local/bin/archfrican-actions"
  }
}
